---
const { frontmatter } = Astro.props;
import PapaHeader from '../components/PapaHeader.astro';
import PapaHero from '../components/PapaHero.astro';
import PapaFooter from '../components/PapaFooter.astro';
import '../styles/global.css';

// hero表示制御
const showHero = frontmatter.showHero !== false;
---
<!doctype html>
<html lang="ja">
    <head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>おつかれ、パパ。</title>
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@300;400;500;700&display=swap" rel="stylesheet">
		<link href="https://fonts.googleapis.com/css2?family=Zen+Kurenaido&display=swap" rel="stylesheet">
		<link href="https://use.fontawesome.com/releases/v7.3.1/css/all.css" rel="stylesheet">
	</head>
    <body>
        <PapaHeader />
		{showHero ? <div class="hero-content"><PapaHero /></div> : null}
	    <div class="container">
	        <slot />
		</div>
		<PapaFooter />
    </body>
</html>

<style>
body {
	background: #faf0e6;
	color: #3d2a18;
}
.container-hero{
    max-width:1200px;
    margin:auto;
    padding: 0 12px;
}
@media(max-width: 928px){
    .container-hero{
        padding: 0;
        margin: -8px;
    }
}
</style>