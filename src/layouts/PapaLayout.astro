---
import PapaHeader from '../components/PapaHeader.astro';
import PapaHero from '../components/PapaHero.astro';
import PapaProfile from '../components/PapaProfile.astro';
import PapaHitokoto from '../components/PapaHitokoto.astro';
import PapaFooter from '../components/PapaFooter.astro';
import '../styles/global.css';
---
<!doctype html>
<html lang="ja">
    <head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta
  name="description"
  content="子育て・仕事・副業に奮闘する30代パパが、育児の悩みやキャリア、副業、マインドセットについて発信するブログです。" />
	  <meta property="og:type" content="website" />
    <meta property="og:title" content="おつかれ、パパ。" />
    <meta property="og:description"
 content="仕事も子育ても頑張るパパのためのライフスタイルブログ" />
    <meta property="og:image"
 content="https://otsukare-papa.com/ogp.png" />
    <meta property="og:url"
 content="https://otsukare-papa.com" />

		<title>おつかれ、パパ。| 仕事も子育ても頑張るパパのためのライフスタイルブログ</title>
		<link rel="canonical" href="https://otsukare-papa.com">
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@300;400;500;700&display=swap" rel="stylesheet">
		<link href="https://fonts.googleapis.com/css2?family=Zen+Kurenaido&display=swap" rel="stylesheet">
		<link href="https://use.fontawesome.com/releases/v7.3.1/css/all.css" rel="stylesheet">
	</head>
    <body>
        <PapaHeader />
		{Astro.props.showHero==="true" ? <div class="container-hero"><PapaHero /></div> : null}
	    <div class="container">
		    <div class="main-pain">
			    <div class="left-pain">
			      <slot />
				  </div>
			  	<div class="right-pain">
				  	<div>
					  	<PapaProfile />
					  	<PapaHitokoto />
				  	</div>
			    </div>
			</div>
		</div>
		<PapaFooter />
  </body>
</html>

<style>
body {
	background: #faf0e6;
	color: #3d2a18;
    margin: 0;
}
.container-hero{
    max-width: 1200px;
    margin: auto;
    padding: 0 12px;
}
@media(max-width: 928px){
    .container-hero{
        padding: 0;
    }
}
.container{
    max-width: 1200px;
    margin: auto;
    padding:0 12px;
}
.main-pain{
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    gap: 20px;
}
.left-pain{
    max-width: 860px;
    flex: 1;
}
.right-pain{
    flex: 0 0 300px;
}

@media(max-width:768px){
    .main-pain{
        flex-direction: column;
    }
    .left-pain{
        max-width: 100%;
    }
    .right-pain{
        flex: 1;
    }
}
</style>