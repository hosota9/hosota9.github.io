---
import { getCollection } from "astro:content";
import Layout from '../layouts/PapaLayout.astro';
import BlogPost from '../components/BlogPost.astro';
const title = "カテゴリー";

/* 各カテゴリーのポストを取得 */
const categories = ["子育て", "仕事・キャリア", "副業・個人開発", "マインドセット", "ライフスタイル"];
let categoryPosts: any[] = [];

for (let i = 0; i < categories.length; i++) {
  const Posts = await getCollection("blog", ({ data }) => {
    return data.category == categories[i];
  })
  Posts.sort((a, b) => b.data.pubdate.valueOf() - a.data.pubdate.valueOf());
  categoryPosts.push({name: categories[i], value: Posts});
}
---
<Layout frontmatter={{ title }} showHero="false">

  {categoryPosts.map((category: any) => (
  <h1>{category.name}</h1>
    <div class="cards">
    {category.value.map((post: any) => (
      <BlogPost post={post} />
    ))}
  </div>

  ))}

</Layout>
  
<style>
  h1 {
    margin-bottom: 24px;
  }
  .cards {
    margin-bottom: 48px;
  }
</style>