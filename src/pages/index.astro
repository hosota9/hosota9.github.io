---
import Layout from '../layouts/PapaLayout.astro';
import PapaHero from '../components/PapaHero.astro';
import PapaPopular from '../components/PapaPopular.astro';
import PapaCategory from '../components/PapaCategory.astro';
import PapaProfile from '../components/PapaProfile.astro';
import PapaHitokoto from '../components/PapaHitokoto.astro';
---
<Layout>
    <div class="container">
    	<PapaHero />
        <div class="main-pain">
            <div class="left-pain">
                <PapaPopular />
                <PapaCategory />
            </div>
            <div class="right-pain">
                <div class="card">
                    <PapaProfile />
                    <PapaHitokoto />
                </div>
            </div>
        </div>
    </div>
</Layout>

<style>
.container{
    max-width:1200px;
    margin:auto;
    padding:0 24px;
}
.main-pain{
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
}
.left-pain{
    max-width: 940px;
    margin-right: 20px;
    flex: 1;
}
.right-pain{
    flex: 0 0 280px;
}

@media(max-width:768px){
	.cards{
		grid-template-columns:1fr;
	}
	.categories{
		grid-template-columns:1fr 1fr;
	}
}

</style>
