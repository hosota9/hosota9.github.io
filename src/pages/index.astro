---
import Layout from '../layouts/PapaLayout.astro';
import PapaPopular from '../components/PapaPopular.astro';
import PapaCategory from '../components/PapaCategory.astro';
import PapaProfile from '../components/PapaProfile.astro';
import PapaHitokoto from '../components/PapaHitokoto.astro';

showHero: true;
---
<Layout>
    <div class="main-pain">
        <div class="left-pain">
            <PapaPopular />
            <PapaCategory />
        </div>
        <div class="right-pain">
            <div class="card">
                <PapaProfile />
                <PapaHitokoto />
            </div>
        </div>
    </div>
</Layout>

<style>
.main-pain{
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    gap: 20px;
}
.left-pain{
    max-width: 940px;
    flex: 1;
}
.right-pain{
    flex: 0 0 300px;
}

@media(max-width:768px){
    .main-pain{
        flex-direction: column;
    }
    .left-pain{
        max-width: 100%;
    }
    .right-pain{
        flex: 1;
    }
}

</style>
