---
import Layout from '../layouts/PapaLayout.astro';
import PapaHero from '../components/PapaHero.astro';
import PapaPopular from '../components/PapaPopular.astro';
import PapaCategory from '../components/PapaCategory.astro';
import PapaProfile from '../components/PapaProfile.astro';
import PapaHitokoto from '../components/PapaHitokoto.astro';
---
<Layout>
    <div class="container-hero">
    	<PapaHero />
    </div>
    <div class="container">
        <div class="main-pain">
            <div class="left-pain">
                <PapaPopular />
                <PapaCategory />
            </div>
            <div class="right-pain">
                <div class="card">
                    <PapaProfile />
                    <PapaHitokoto />
                </div>
            </div>
        </div>
    </div>
</Layout>

<style>
.container-hero{
    max-width:1200px;
    margin:auto;
    padding: 0 12px;
}
@media(max-width: 928px){
    .container-hero{
        padding: 0;
        margin: -8px;
    }
}
.container{
    max-width:1200px;
    margin:auto;
    padding:0 12px;
}
.main-pain{
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    gap: 20px;
}
.left-pain{
    max-width: 940px;
    flex: 1;
}
.right-pain{
    flex: 0 0 300px;
}

@media(max-width:768px){
    .main-pain{
        flex-direction: column;
    }
    .left-pain{
        max-width: 100%;
    }
    .right-pain{
        flex: 1;
    }
}

</style>
