---
import Layout from '../layouts/PapaLayout.astro';
import PapaHero from '../components/PapaHero.astro';
import PapaPopular from '../components/PapaPopular.astro';
import PapaCategory from '../components/PapaCategory.astro';
---
<Layout>
    <div class="container">
    	<PapaHero />
        <div class="main-pain">
            <div class="left-pain">
                <PapaPopular />
                <PapaCategory />
            </div>
            <div class="right-pain">
                <div class="card">
                    papaのプロフィール
                </div>
            </div>
        </div>
    </div>

<section class="container">

<div class="message">

<h2>今日も、おつかれさま。</h2>

<p>
誰かと比べなくていい。<br>
家族を大切にしようとしているだけで十分すごい。<br>
この場所が、あなたの小さな休憩所になりますように。
</p>

</div>

</section>

</Layout>

<style>
.container{
    max-width:1200px;
    margin:auto;
    padding:0 24px;
}
.main-pain{
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
}
.left-pain{
    flex-basis: 820px;
}
.right-pain{
    flex-basis: 200px;
}

/* Message */
.message{
    background:#f6ead4;
    padding:80px 20px;
    text-align:center;
    border-radius:32px;
}

.message h2{
    font-size:2.5rem;
    margin-bottom:20px;
}

@media(max-width:768px){
	.cards{
		grid-template-columns:1fr;
	}
	.categories{
		grid-template-columns:1fr 1fr;
	}
}
</style>
