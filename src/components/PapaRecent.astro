---
import { getCollection } from 'astro:content';

const recentPosts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubdate.valueOf() - a.data.pubdate.valueOf())
  .slice(0, 5);
---

<section class="recent-posts">
  <h2><i class="fa-solid fa-clock-rotate-left"></i>新着記事</h2>

  <ul class="recent-list">
    {recentPosts.map((post) => (
      <li class="recent-item">
        <a href={`/posts/${post.id}/`}>
          <span class="recent-date"><i class="fa-regular fa-clock"></i> {post.data.pubdate.toLocaleDateString('ja-JP').replaceAll('/', '.')}</span>
          <span class="recent-title">{post.data.title}</span>
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
.recent-posts {
  background: #f6ead4;
  border-radius: 20px;
  padding: 16px 16px 10px;
  box-sizing: border-box;
}

h2 {
  font-size: 1rem;
  margin: 0;
  padding-bottom: 8px;
  border-bottom: solid 1px #c0b090;
}

.fa-clock-rotate-left {
  margin-right: 8px;
  color: #eca007;
}

.recent-list {
  list-style: none;
  margin: 20px 0 0 0;
  padding: 0;
}

.recent-item + .recent-item {
  margin-top: 10px;
}

.recent-item a {
  display: block;
  padding: 8px 10px;
  border-radius: 12px;
  text-decoration: none;
  background: rgba(255, 255, 255, 0.25);
  transition: background-color 0.2s ease-in-out;
}

.recent-item a:hover {
  background: rgba(255, 255, 255, 0.45);
}

.recent-date {
  display: block;
  font-size: 0.7rem;
  color: #86664a;
  margin-bottom: 6px;
}

.recent-title {
  display: block;
  font-size: 0.88rem;
  line-height: 1.6;
  color: #3d2a18;
  font-weight: 500;
}
</style>
