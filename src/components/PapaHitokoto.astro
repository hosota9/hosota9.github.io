---
import HitokotoImg from "../assets/hitokoto/hitokoto-001.png"
---

<section>
    <h2>今日のひとこと</h2>
    <p>「完璧なパパ」より、<br>
    「笑っているパパ」でいよう。</p>
    <img src={HitokotoImg.src} alt="今日のひとこと">
</section>

<style>
section{
    padding:16px;
    background:#f6ead4;
    border-radius:20px;
}
h2{
    font-size: 1rem;
    margin-top: 0;
    margin-bottom:20px;
    padding-bottom: 8px;
    text-align:center;
    border-bottom: solid 1px #c0b090;
}
p{
    font-size: 0.8rem;
    line-height: 1.75;
    margin-bottom:20px;
}
img {
    width:100%;
    border-radius:8px;
    background-size:cover;
    background-position:center;
    background-color:#e4d4b5;
    text-align:center;
    margin:auto;
}
</style>
