---
import HeaderLogo from '../assets/logo_header.png'
---

<header>
    <div class="container navbar">
        <div>
            <a href="/">
                <img src={HeaderLogo.src} alt="おつかれ、パパ。" id="header-logo" />
            </a>
        </div>

        <nav>
            <ul>
                <li><a href="/">ホーム</a></li>
                <li><a href="/posts">記事一覧</a></li>
                <li><a href="/categories">カテゴリー</a></li>
                <li><a href="/about">プロフィール</a></li>
                <li><a href="/contact">お問い合わせ</a></li>
            </ul>
        </nav>
    </div>
</header>

<style>
body {
    font-family: 'Noto Sans JP', sans-serif;
    color:#3d2a18;
    letter-spacing: 0.05em;
}

.container{
    max-width:1200px;
    margin:auto;
    padding:0 12px;
}

header{
    background:#faf0e6;
    top:0;
    border-bottom:1px solid #eee;
    margin-bottom: 24px;
}

.navbar{
    display:flex;
    justify-content:space-between;
    align-items:center;
    padding: 0;
}

nav ul{
    display:flex;
    list-style:none;
    gap:32px;
}
@media(max-width: 928px){
    nav ul{
        display: none;
    }
}

nav a{
    text-decoration:none;
    color:#444;
}

#header-logo {
    width: 240px;
}
</style>
