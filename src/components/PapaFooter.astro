---
import FooterLogo from '../assets/logo_footer.png'
---

<footer>
    <img src={FooterLogo.src} alt="FooterLogo" id="footer-logo"/>
    <div id="footer-content">
        <div><a href="/">ホーム</a>　/　<a href="/posts">記事一覧</a>　/　<a href="/categories">カテゴリ</a>　/　<a href="/about">プロフィール</a>　/　<a href="/contact">お問い合わせ</a></div>
        <div>© 2026 hosota9. All rights reserved.</div>
    </div>
</footer>

<style>
footer {
    margin-top:80px;
    background:#3f2d1f;
    color:#c0b090;
    text-align:center;
    padding:12px;
	font-size:0.8rem;
    display: flex;
    justify-content: center;
}
#footer-logo {
    width: 240px;
    margin-right: 24px;
    margin-bottom: 20px;
}
#footer-content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 12px;
}
@media(max-width: 768px) {
    #footer-content {
        justify-content: row;
    }
}
a {
    color:#c0b090;
}
</style>
